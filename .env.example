# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/studiospace_db?retryWrites=true&w=majority
DB_NAME=studiospace_db

# JWT Security Secret (Used in Phase 02 for HTTPOnly Cookie signing)
JWT_SECRET=replace_with_a_strong_64_character_hex_secret_key

# Allowed Frontend Origins (Comma-separated if multiple)
CLIENT_URL=http://localhost:3000