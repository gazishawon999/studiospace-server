# =============================================================================
# StudioSpace Server — environment variables
#
# 1. Copy this file:            cp .env.example .env
# 2. Replace every <placeholder> with a real value.
# 3. Restart the server after editing .env.
#
# NEVER commit .env. See docs/environment.md for where to obtain each value.
#
# This file is for the Express server only. Never add NEXT_PUBLIC_* variables
# or any other value that is meant to be visible in the browser bundle.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API.
# Local development: the Next.js app.
# This value also becomes Better Auth's trusted origin list, which Google
# OAuth redirects are validated against.
CLIENT_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. MongoDB Atlas
# -----------------------------------------------------------------------------
# MongoDB Atlas -> Database -> Connect -> Drivers.
# Replace <username>, <password>, and <cluster-host>.
# URL-encode special characters in the password (for example @ becomes %40).
MONGODB_URI=mongodb://studiospace-user:jIRv9XQsZAfXX2o8@ac-zuf7dkf-shard-00-00.aidxdby.mongodb.net:27017,ac-zuf7dkf-shard-00-01.aidxdby.mongodb.net:27017,ac-zuf7dkf-shard-00-02.aidxdby.mongodb.net:27017/?ssl=true&replicaSet=atlas-2ie4uq-shard-0&authSource=admin
DB_NAME=studiospace_db

# -----------------------------------------------------------------------------
# 3. Express JWT + HTTPOnly session cookie
# -----------------------------------------------------------------------------
# These settings control the JWT cookie issued by Express. Better Auth manages
# its own session cookie separately; do not reuse AUTH_COOKIE_NAME for it.
#
# Generate a 64-character hex secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=2c53eae7b06440c29ecd8d5bcf3d71ef8ceb42e17353aff35439cf0eec880ef8b0d62f36e0d668d5b88fbc470730ea2cad2e00f13e50f6afb7f4af1f74634a96
# Lifetime format: 60s, 15m, 24h, 7d.
JWT_EXPIRES_IN=7d
# Issuer/audience claims verified by the Express auth middleware.
JWT_ISSUER=studiospace-api
JWT_AUDIENCE=studiospace-client

AUTH_COOKIE_NAME=studiospace_session
# lax | strict | none
# Use "none" only for cross-site HTTPS deployments (requires AUTH_COOKIE_SECURE=true).
AUTH_COOKIE_SAME_SITE=lax
# true in production (HTTPS). Keep false for local http://localhost.
AUTH_COOKIE_SECURE=false
# Leave empty for localhost. Set to .yourdomain.com only to share the cookie
# across subdomains.
AUTH_COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# 4. Better Auth (MongoDB adapter)
# -----------------------------------------------------------------------------
# Better Auth runs on this Express server and is mounted at /api/auth.
# Generate a random secret of at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=WTAqYG1Vfv12DxmGiJud0x2huRgtBUjb
# Public origin of THIS Express server (the auth server). No path, no slash.
# Local: http://localhost:5000
BETTER_AUTH_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# 5. Google OAuth 2.0
# -----------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (application type: Web application).
#
# Authorised JavaScript origins:
#   http://localhost:3000
# Authorised redirect URIs:
#   http://localhost:5000/api/auth/callback/google
#
# Add the production equivalents before deploying.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# -----------------------------------------------------------------------------
# 6. ImgBB (server-side image uploads)
# -----------------------------------------------------------------------------
# https://api.imgbb.com/ -> Get API key.
# This key is used only by this Express server. NEVER expose it to the browser.
IMGBB_API_KEY=f3306924a3efac53d7b68a0a3258ba47

# =============================================================================
# The server starts in development even while the Better Auth, Google OAuth,
# and ImgBB values above are still placeholders; it prints a warning that names
# each missing variable. With NODE_ENV=production those values are mandatory
# and the server refuses to start without them.
# =============================================================================
